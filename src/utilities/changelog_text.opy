#!mainFile "../main.opy"
#!optimizeStrict

# 高频重复文本片段，声明在全局数组 ChangelogCommon 中，各英雄条目通过
# ChangelogCommon[i] 引用，避免每个英雄正文重复内嵌同样的字符串。
# 0: "\r\n●"                    英雄名标题前缀
# 1: "\n\n※※离开重生室隐藏"       离开重生室隐藏 后缀
# 2: "\n\n※离开重生室隐藏"        离开重生室隐藏 后缀变体
# 3: "\r\n*造成伤害 "           造成伤害 行前缀（正负号随数值内联）
# 4: "\r\n*造成治疗 "           造成治疗 行前缀
# 5: "\r\n*受到伤害 "           受到伤害 行前缀

#!define changelog_database [ \
