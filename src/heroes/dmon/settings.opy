#!mainFile "../../main.opy"

# D.Mon Main balance values (shared rules, mode-specific tuning).
# Workshop setting cards are not used: the ARAM build is already at the
# 128-setting cap, so Main/ARAM differences are expressed as #!define
# constants in the mutually exclusive dmon/settings.opy vs
# dmon/settings.aram.opy include.
#!define DMON_PRIMARY_MAX_HEALTH_PERCENT 7
#!define DMON_PRIMARY_HEAL 20
#!define DMON_DASH_SPEED_PERCENT 30
#!define DMON_DASH_STUN_DURATION 0.6
#!define DMON_ULT_KNOCKDOWN_DURATION 1.0
